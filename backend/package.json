{
  "name": "nohonu-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:dev": "prisma generate && prisma migrate dev",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "dev": "npm run db:dev && tsx watch main.ts",
    "start": "npm run db:deploy && tsx main.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.0",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.7",
    "prisma": "^7.9.1",
    "tsx": "^4.19.4",
    "typescript": "~6.0.2",
    "vitest": "^3.1.3"
  }
}
