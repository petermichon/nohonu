{
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "include": ["./"],
    "rules": {
      "tags": ["recommended"],
      "include": [
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "eqeqeq",
        "no-non-null-assertion",
        "no-throw-literal",
        "camelcase"
      ]
    }
  },
  "fmt": {
    "include": ["./"]
  },
  "tasks": {
    "dev": "deno run --watch -P=dev --no-prompt main.ts",
    "start": "deno run -P=dev --no-prompt main.ts",
    "format": "deno run -A npm:prettier --write .",
    "format:check": "deno run -A npm:prettier --check .",
    "test": "deno test -P=test"
  },
  "permissions": {
    "dev": {
      "sys": true,
      "ffi": true,
      "net": true,
      "env": true,
      "read": true,
      "write": true
    },
    "test": {
      "read": true,
      "write": ["/tmp"],
      "env": true
    }
  }
}
