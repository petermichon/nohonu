{
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "lint": {
    "include": ["./"],
    "rules": {
      "tags": ["recommended"],
      "include": ["explicit-function-return-type", "explicit-module-boundary-types", "eqeqeq"]
    }
  },
  "fmt": {
    "include": ["./"]
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read=./data --allow-write=./data --no-prompt main.ts",
    "start": "deno run --allow-net --allow-env --allow-read=./data --allow-write=./data --no-prompt main.ts",
    "format": "deno run -A npm:prettier --write .",
    "format:check": "deno run -A npm:prettier --check .",
    "test": "deno test --allow-read --allow-write=/tmp --allow-env"
  }
}
