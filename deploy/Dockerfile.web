# Static platform frontend, served behind the shared edge proxy.
FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
ARG VITE_API_BASE
RUN if [ -n "$VITE_API_BASE" ]; then export VITE_API_BASE="$VITE_API_BASE"; else unset VITE_API_BASE; fi && npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
