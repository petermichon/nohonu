{
	on_demand_tls {
		ask http://backend:8080/check-custom-domain
	}
}

{$DOMAIN:localhost:80} {
	handle_path /api/* {
		reverse_proxy backend:8080
	}
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

*.{$DOMAIN:localhost} {
	reverse_proxy backend:8080
	tls internal
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy backend:8080
}
