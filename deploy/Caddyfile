{
	on_demand_tls {
		ask http://localhost:2020/check-custom-domain
	}
}

http://localhost:2020 {
	reverse_proxy backend:8080 {
		header_up X-Server-Password {env.SERVER_PASSWORD}
	}
}

{$DOMAIN:localhost:80} {
	handle_path /api/* {
		reverse_proxy backend:8080
	}
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

*.{$DOMAIN:localhost} {
	reverse_proxy backend:8080
	tls {$WILDCARD_TLS:internal}
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy backend:8080
}
