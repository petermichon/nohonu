# Required: Secret key for API authentication
# Generate with: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-secret

# Required for production: Your domain name (e.g., nohonu.com)
# Used for HTTPS certificates and subdomain serving
DOMAIN=nohonu.com

# Production: set to your domain to enable automatic HTTPS
# Leave unset for local development (HTTP on localhost:80)
SITE_HOSTNAME=nohonu.com

# Optional: OVH DNS credentials for wildcard HTTPS certificates
# Required for production to enable *.DOMAIN wildcard subdomains with TLS
# Get these from https://eu.api.ovh.com/createToken/
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=your_application_key
OVH_APPLICATION_SECRET=your_application_secret
OVH_CONSUMER_KEY=your_consumer_key

# Optional: Restrict CORS to a specific origin (e.g., https://nohonu.com)
# Defaults to * (any origin) if not set
ALLOWED_ORIGIN=https://nohonu.com

# Optional: Server IP address for custom domain A record instructions
# Used in DNS setup instructions for custom domains
SERVER_IP=1.2.3.4
