# Required: Secret key for API authentication
# Generate with: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-secret

# Required for production: Your domain name (e.g., petermichon.fr)
# Used for HTTPS certificates and subdomain serving
DOMAIN=petermichon.fr

# Optional: Restrict CORS to a specific origin (e.g., https://petermichon.fr)
# Defaults to * (any origin) if not set
# ALLOWED_ORIGIN=https://petermichon.fr
